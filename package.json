{
  "name": "newswatch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:up": "pnpm --filter @newswatch/api db:up",
    "db:seed": "pnpm --filter @newswatch/api db:seed",
    "worker": "pnpm --filter @newswatch/api worker",
    "mobile:prebuild": "npm --prefix apps/mobile run prebuild:android",
    "mobile:build": "npm --prefix apps/mobile run build:android",
    "mobile:build:debug": "npm --prefix apps/mobile run build:android:debug",
    "mobile:build:debug:emulator": "npm --prefix apps/mobile run build:android:debug:emulator",
    "mobile:build:release:fast": "npm --prefix apps/mobile run build:android:release:fast",
    "mobile:bundle": "npm --prefix apps/mobile run build:android:bundle",
    "mobile:install": "npm --prefix apps/mobile run install:android"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
