# Base URL of the API (include /api/v1). On a physical device this must be
# reachable from the phone — use your machine's LAN IP, an ngrok URL, or
# http://10.0.2.2:4010/api/v1 for the Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:4010/api/v1

# Base URL of the realtime server (no /socket.io suffix; the client appends it).
EXPO_PUBLIC_SOCKET_URL=http://localhost:4010
