{
  "name": "@newswatch/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "clean:expo-config": "node scripts/clean-expo-config.mjs",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:android:clean": "expo prebuild --platform android --clean",
    "build:android": "npm run clean:expo-config && expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:android:debug": "npm run clean:expo-config && expo prebuild --platform android && cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "build:android:debug:emulator": "npm run clean:expo-config && expo prebuild --platform android && cd android && ./gradlew assembleDebug -PreactNativeArchitectures=x86_64",
    "build:android:release:fast": "npm run clean:expo-config && expo prebuild --platform android && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:android:bundle": "npm run clean:expo-config && expo prebuild --platform android && cd android && ./gradlew bundleRelease",
    "install:android": "cd android && ./gradlew installRelease",
    "install:android:debug:emulator": "cd android && ./gradlew installDebug -PreactNativeArchitectures=x86_64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@newswatch/shared": "workspace:*",
    "@newswatch/tokens": "workspace:*",
    "@react-native/assets-registry": "0.74.87",
    "@react-native/js-polyfills": "0.74.87",
    "@react-native/normalize-colors": "0.74.87",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~51.0.39",
    "expo-asset": "~10.0.10",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image": "~1.13.0",
    "expo-image-picker": "~15.0.7",
    "expo-keep-awake": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-modules-core": "~1.12.26",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-video": "~1.2.7",
    "react": "18.3.1",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "socket.io-client": "^4.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/config-plugins": "8.0.11",
    "@newswatch/config": "workspace:*",
    "@react-native/gradle-plugin": "^0.74.87",
    "@types/node": "^22.7.4",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.15",
    "typescript": "~5.3.3",
    "vitest": "^2.1.2"
  }
}
