# ---- Core ----
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgresql://newswatch:newswatch@localhost:55432/newswatch?schema=public
PG_POOL_MAX=10

# ---- Redis ----
REDIS_URL=redis://localhost:56379

# ---- JWT ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TTL=15m
REFRESH_TTL=30d

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=newswatch-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL=600

# ---- OTP / Email / SMS ----
OTP_TTL=300
OTP_LENGTH=6
SMS_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=
EMAIL_FROM=no-reply@newswatch.app

# ---- OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Push (FCM) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Realtime ----
SOCKET_CORS_ORIGIN=*
SOCKET_PATH=/socket.io

# ---- Observability ----
SENTRY_DSN=

# ---- Media processing binaries ----
FFMPEG_PATH=
FFPROBE_PATH=
MEDIA_WORKER_ENABLED=true
